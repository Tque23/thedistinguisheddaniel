---
// src/pages/contact.astro
import Layout from "../layouts/layout.astro";
---

<Layout title="The Distinguished Daniel Network and Institute | Contact">
  <div class="contact-container">
    <div class="bg-shape-1"></div>
    <div class="bg-shape-2"></div>

    <div class="glass-panel contact-panel">
      <h1>Get In Touch</h1>
      <h2 class="subheading">Direct Access to the Inner Circle</h2>

      <div class="info-section">
        <h3 class="person-name">Mqo Mavundla</h3>
        <p class="role-text">For more info and direct inquiries</p>

        <a
          href="https://wa.me/27832506306"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp contact-btn"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="whatsapp-icon"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.67-1.622-.918-2.218-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c-.001 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          <span>+27 83 250 6306</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-container {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    position: relative;
    min-height: 70vh;
  }

  /* Inheriting your abstract background shapes */
  .bg-shape-1,
  .bg-shape-2 {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
  }

  .bg-shape-1 {
    width: 400px;
    height: 400px;
    background: var(--brand-navy);
    top: -50px;
    left: 10%;
    opacity: 0.4;
  }

  .bg-shape-2 {
    width: 300px;
    height: 300px;
    background: var(--accent-burgundy);
    bottom: 10%;
    right: 10%;
    opacity: 0.25;
  }

  /* Custom Contact Glass Panel */
  .contact-panel {
    position: relative;
    z-index: 1;
    background: rgba(29, 53, 87, 0.15);
    border: 1px solid rgba(243, 210, 122, 0.2);
    border-radius: 16px;
    padding: 4rem 3rem;
    text-align: center;
    max-width: 600px;
    width: 100%;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  }

  h1 {
    font-family: "Trajan Pro 3", serif;
    font-weight: 600;
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    letter-spacing: 0.5px;
  }

  .subheading {
    font-family: "Trajan Pro 3", serif;
    font-weight: 400;
    font-size: 1.1rem;
    margin-bottom: 3rem;
    color: var(--accent-gold-end);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Information Display Card */
  .info-section {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: inset 0 2px 15px rgba(0, 0, 0, 0.1);
  }

  .person-name {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .role-text {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2.5rem;
  }

  /* WhatsApp Action Button Override */
  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 350px;
  }

  .btn-whatsapp {
    background-color: #25d366;
    color: #ffffff;
    border: 1px solid #25d366;
    font-weight: 600;
  }

  .btn-whatsapp:hover {
    background-color: #1ebe5d;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
  }

  .whatsapp-icon {
    flex-shrink: 0;
  }

  /* Mobile Optimization */
  @media (max-width: 768px) {
    .contact-panel {
      padding: 3rem 1.5rem;
    }

    .info-section {
      padding: 2rem 1rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    .person-name {
      font-size: 1.5rem;
    }

    .contact-btn {
      font-size: 1rem;
      padding: 0.85rem 1.25rem;
    }
  }
</style>
