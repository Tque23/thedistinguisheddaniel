---
import Layout from "../layouts/layout.astro";
---

<Layout title="The Distinguished Daniel Network & Institute | Leadership, Legacy and Influence">
  <main class="landing-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">THE DISTINGUISHED DANIEL NETWORK & INSTITUTE</p>
        <h1 id="hero-title">The standard is higher.<br /><em>The circle is smaller.</em></h1>
        <p class="hero-lede">A private network for Kingdom ambassadors, leaders, and builders who are committed to influence with excellence.</p>
        <div class="hero-actions">
          <a class="primary-link" href="#early-access">Join the academy <span aria-hidden="true">↗</span></a>
          <a class="secondary-link" href="#about">Discover the vision</a>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <div class="mark-ring"></div>
        <img src="/logos/logo-square.svg" alt="" />
        <span>EST. 2026</span>
      </div>
      <div class="scroll-cue" aria-hidden="true"><span></span>SCROLL TO EXPLORE</div>
    </section>

    <section class="intro-section" id="about" aria-labelledby="about-title">
      <div class="section-number">01 <span></span></div>
      <div class="intro-grid">
        <p class="section-kicker">A NEW KIND OF INSTITUTION</p>
        <div>
          <h2 id="about-title">For those who carry<br /><em>the weight of purpose.</em></h2>
          <p class="body-copy">The Distinguished Daniel is a private community built around the timeless values of wisdom, discipline, and service. We bring together a select group of people who are ready to do meaningful work and leave a lasting legacy.</p>
          <a class="text-link" href="#principles">Our principles <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="principles-section" id="principles" aria-labelledby="principles-title">
      <div class="section-number light">02 <span></span></div>
      <div class="principles-head"><p class="section-kicker">THE DISTINGUISHING PRINCIPLES</p><h2 id="principles-title">What sets us apart</h2></div>
      <div class="principles-grid">
        <article><span>01</span><h3>Character</h3><p>We lead from the inside out. Integrity is the foundation for every conversation, opportunity, and connection.</p></article>
        <article><span>02</span><h3>Competence</h3><p>We pursue mastery. Our members bring curiosity, craft, and an uncompromising commitment to excellence.</p></article>
        <article><span>03</span><h3>Contribution</h3><p>We build beyond ourselves. Influence is measured by the lives, businesses, and communities we elevate.</p></article>
      </div>
    </section>

    <section class="invite-section" id="early-access" aria-labelledby="invite-title">
      <div class="invite-card">
        <p class="section-kicker">THE FIRST CIRCLE</p>
        <h2 id="invite-title">Your invitation<br /><em>is waiting.</em></h2>
        <p>Applications for founding membership are now open. Secure your place in a network designed for the next generation of distinguished leaders.</p>
        <a class="primary-link dark-link" href="/contact">Request an invitation <span aria-hidden="true">↗</span></a>
      </div>
      <div class="invite-details"><p class="detail-label">OFFICIAL LAUNCH</p><p class="detail-value">03.10.2026</p><p class="detail-note">Founding membership<br />limited by design.</p></div>
    </section>
  </main>
</Layout>

<style>
  @font-face { font-family: "Trajan Pro 3"; src: url("/fonts/Trajan Pro 3 Regular.otf") format("opentype"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Trajan Pro 3"; src: url("/fonts/Trajan Pro 3 Semibold.otf") format("opentype"); font-weight: 600; font-display: swap; }
  :global(:root) { --navy: #1d3557; --ink: #0d0d0d; --cream: #eee8dc; --gold: #c89b3c; --gold-light: #f3d27a; --muted: #c7c7c7; }
  .landing-page { background: var(--ink); color: #f8f9fa; }
  .hero { min-height: calc(100vh - 84px); padding: clamp(5rem, 11vw, 9rem) clamp(1.5rem, 8vw, 8rem) 4rem; display: flex; align-items: center; position: relative; overflow: hidden; background: radial-gradient(circle at 75% 42%, rgba(29,53,87,.85), transparent 36%), linear-gradient(115deg, #0d0d0d 0%, #152640 100%); }
  .hero::after { content: ""; position: absolute; right: -12%; top: -20%; width: 58vw; height: 100%; border: 1px solid rgba(243,210,122,.14); border-radius: 50%; transform: rotate(-25deg); }
  .hero-copy { position: relative; z-index: 1; max-width: 800px; }
  .eyebrow, .section-kicker, .detail-label { font: 600 .72rem/1.4 "Trajan Pro 3", serif; letter-spacing: .2em; color: var(--gold-light); }
  h1, h2, h3 { font-family: "Trajan Pro 3", serif; font-weight: 400; letter-spacing: -.03em; }
  h1 { margin: 1.5rem 0; max-width: 850px; font-size: clamp(3.2rem, 7vw, 7.8rem); line-height: .98; }
  h1 em, h2 em { color: var(--gold-light); font-style: normal; }
  .hero-lede { max-width: 510px; color: #d9dee4; font: 1.1rem/1.7 system-ui, sans-serif; }
  .hero-actions { display: flex; gap: 2rem; align-items: center; margin-top: 2.7rem; }
  .primary-link, .secondary-link, .text-link { font: 600 .78rem/1.2 system-ui, sans-serif; letter-spacing: .15em; text-transform: uppercase; text-decoration: none; }
  .primary-link { display: inline-flex; gap: 1rem; align-items: center; padding: 1.05rem 1.35rem; color: var(--ink); background: var(--gold-light); }
  .primary-link:hover { background: #fff1b7; }
  .secondary-link { color: #fff; border-bottom: 1px solid rgba(255,255,255,.55); padding-bottom: .6rem; }
  .hero-mark { position: absolute; right: clamp(3rem, 12vw, 13rem); top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: clamp(180px, 22vw, 320px); opacity: .84; }
  .hero-mark img { width: 52%; filter: brightness(0) invert(1); }
  .mark-ring { position: absolute; inset: 0; border: 1px solid rgba(243,210,122,.55); border-radius: 50%; }
  .hero-mark span { margin-top: 1.5rem; font: .58rem "Trajan Pro 3", serif; letter-spacing: .25em; color: var(--gold-light); }
  .scroll-cue { position: absolute; bottom: 2rem; left: clamp(1.5rem, 8vw, 8rem); font: .58rem system-ui, sans-serif; letter-spacing: .2em; color: #aab3be; display: flex; align-items: center; gap: .8rem; }
  .scroll-cue span { display: block; width: 34px; height: 1px; background: var(--gold); }
  .intro-section, .principles-section, .invite-section { padding: clamp(5rem, 10vw, 10rem) clamp(1.5rem, 8vw, 8rem); }
  .intro-section { background: var(--cream); color: var(--ink); }
  .section-number { font: .7rem system-ui, sans-serif; letter-spacing: .2em; color: var(--gold); display: flex; gap: 1rem; align-items: center; }
  .section-number span { width: 70px; height: 1px; background: currentColor; }
  .intro-grid { max-width: 1200px; margin: 5rem auto 0; display: grid; grid-template-columns: 1fr 1.5fr; gap: 5rem; }
  .intro-section .section-kicker { color: var(--navy); }
  h2 { font-size: clamp(2.5rem, 5vw, 5.4rem); line-height: 1.03; margin: 0 0 2rem; }
  .body-copy { max-width: 560px; color: #464b50; font: 1.1rem/1.8 system-ui, sans-serif; }
  .text-link { display: inline-block; color: var(--navy); margin-top: 2.5rem; border-bottom: 1px solid var(--gold); padding-bottom: .6rem; }
  .principles-section { background: var(--navy); }
  .principles-head { max-width: 1200px; margin: 4rem auto 5rem; }.principles-head h2 { color: #fff; margin-top: 1rem; }.principles-section .section-kicker { color: var(--gold-light); }
  .principles-grid { max-width: 1200px; margin: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid rgba(255,255,255,.25); }
  .principles-grid article { padding: 2rem 2.5rem 0 0; border-right: 1px solid rgba(255,255,255,.25); margin-right: 2.5rem; }.principles-grid article:last-child { border: 0; }.principles-grid span { color: var(--gold-light); font: .7rem system-ui; letter-spacing: .15em; }.principles-grid h3 { font-size: 2.3rem; color: #fff; margin: 2rem 0 1rem; }.principles-grid p { color: #c9d0d8; font: 1rem/1.7 system-ui; }
  .invite-section { background: var(--gold-light); color: var(--ink); display: grid; grid-template-columns: 1.4fr .6fr; gap: 5rem; }.invite-section .section-kicker { color: var(--navy); }.invite-card { max-width: 700px; }.invite-card p:not(.section-kicker) { max-width: 550px; font: 1.1rem/1.7 system-ui; color: #343434; margin-bottom: 2rem; }.dark-link { background: var(--navy); color: #fff; }.invite-details { border-left: 1px solid rgba(13,13,13,.3); padding-left: 3rem; align-self: end; }.detail-label { color: var(--navy); }.detail-value { font: 600 clamp(2.2rem, 5vw, 5rem) "Trajan Pro 3"; margin: 1rem 0; }.detail-note { font: .95rem/1.6 system-ui; }
  @media (max-width: 800px) { .hero { min-height: 720px; align-items: flex-end; padding-bottom: 6rem; }.hero-mark { top: 20%; right: 1.5rem; width: 150px; }.hero-mark img { width: 45%; }.hero-actions { align-items: flex-start; flex-direction: column; gap: 1.5rem; }.intro-grid, .invite-section { grid-template-columns: 1fr; gap: 2.5rem; }.intro-grid { margin-top: 3rem; }.principles-grid { grid-template-columns: 1fr; }.principles-grid article { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.25); margin: 0; padding: 2rem 0; }.invite-details { border-left: 0; border-top: 1px solid rgba(13,13,13,.3); padding: 2rem 0 0; } }
</style>

<script>
  const countdownTarget = new Date("2026-10-03T00:00:00").getTime();
  const updateCountdown = () => {
    const remaining = Math.max(0, countdownTarget - Date.now());
    const days = Math.floor(remaining / 86400000);
    const hours = Math.floor((remaining / 3600000) % 24);
    const minutes = Math.floor((remaining / 60000) % 60);
    document.title = `The Distinguished Daniel | ${days} days until launch`;
  };
  updateCountdown();
  setInterval(updateCountdown, 60000);
</script>
