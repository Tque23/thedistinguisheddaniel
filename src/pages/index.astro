---
// src/pages/index.astro
import Layout from "../layouts/layout.astro";
---

<Layout title="The Distinguished Daniel Network and Institute | Early Access">
  <main>
    <section class="hero hero-agent" aria-labelledby="hero-title">
      <div class="hero-video" aria-hidden="true">
        <video autoplay muted loop playsinline>
          <source src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/bg-hero-0BnFGdr81Ifnj3WbBZoNt1KE4D5DMT.mp4" type="video/mp4" />
        </video>
        <div class="video-wash"></div>
        <div class="hero-grid-lines"></div>
      </div>

      <nav class="hero-nav" aria-label="Primary navigation">
        <a href="#top" class="hero-brand">
          <img src="/favicon.svg" alt="The Distinguished Daniel emblem" />
          <span>The Distinguished<br />Daniel</span>
        </a>
        <div class="hero-links">
          <a href="#principles">Principles</a>
          <a href="#launch">Launch</a>
          <a href="#early-access" class="nav-cta">Enter the circle</a>
        </div>
      </nav>

      <div class="agent-hero-content" id="top">
        <div class="agent-hero-copy">
          <p class="agent-eyebrow"><span></span> Autonomous leadership for a distributed world</p>
          <h1 id="hero-title">Distributed influence,<br />leaders that <span class="blur-word" aria-live="polite">lead</span></h1>
        </div>
      </div>

      <div class="agent-stats" aria-label="Network statistics">
        <div><strong>3500+</strong><span>ambassadors active</span></div>
        <div><strong>99.7%</strong><span>network uptime</span></div>
        <div><strong>&lt;50ms</strong><span>connection latency</span></div>
      </div>
    </section>

    <div class="bg-shape-1"></div>
    <div class="bg-shape-2"></div>

    <div class="glass-panel" id="early-access">
      <!-- Square Logo Placeholder -->
      <img src="/favicon.svg" alt="Institute Emblem" class="panel-logo" />

      <h1>The Distinguished Daniel</h1>
      <h2 class="subheading">Network & Institute</h2>

      <p>
        Step into an exclusive community designed for forward-thinking Kingdom
        Ambassadors. Secure your position today and join our inner circle before
        the official unveiling.
      </p>

      <!-- Action Buttons -->
      <div class="action-buttons">
        <a href="#" id="openSignupModal" class="btn btn-primary"
          >Early Sign Up</a
        >
        <a
          href="https://chat.whatsapp.com/GGKbAOLHWMcH8qVdozLTdB?s=cl&p=i&mlu=0"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp">Join WhatsApp Group</a
        >
      </div>

      <h2 class="subheading">Official Launch</h2>
      <h2 class="subheading">Saturday, 3 October 2026</h2>

      <div id="countdown">
        <div class="time-box">
          <span class="time-value" id="days">00</span>
          <span class="time-label">Days</span>
        </div>
        <div class="time-box">
          <span class="time-value" id="hours">00</span>
          <span class="time-label">Hours</span>
        </div>
        <div class="time-box">
          <span class="time-value" id="minutes">00</span>
          <span class="time-label">Minutes</span>
        </div>
        <div class="time-box">
          <span class="time-value" id="seconds">00</span>
          <span class="time-label">Seconds</span>
        </div>
      </div>

      <br />
      <br />

      <p class="fine-text">
        You will notice some changes to the website as we prepare for our
        official launch. Don't be alarmed, these are just temporary adjustments
        to enhance your experience.
      </p>

      <br />

      <p class="fine-text">We are preparing something exciting!</p>
    </div>

    <!-- Sign Up Modal -->
    <div id="signupModal" class="modal-overlay">
      <div class="modal-glass">
        <span class="modal-close" id="closeSignupModal">&times;</span>

        <div class="modal-scroll-wrapper">
          <h3 class="modal-title">Secure Your Position</h3>
          <p class="modal-subtitle">
            Fill in your details to join the inner circle.
          </p>

          <form id="signupForm" class="modal-form">
            <div class="form-group">
              <label for="servFullName"
                >Full Name <span class="required">*</span></label
              >
              <input
                type="text"
                id="servFullName"
                name="servFullName"
                required
                placeholder="Daniel Doe"
              />
            </div>

            <div class="form-group">
              <label for="servEmail"
                >Email Address <span class="required">*</span></label
              >
              <input
                type="email"
                id="servEmail"
                name="servEmail"
                required
                placeholder="daniel@example.com"
              />
            </div>

            <div class="form-group">
              <label for="servPhone">Phone Number</label>
              <input
                type="tel"
                id="servPhone"
                name="servPhone"
                placeholder="eg. +27 77 420 4639"
              />

              <div id="whatsappCheckboxContainer" class="whatsapp-container">
                <input type="checkbox" id="servWhatsApp" name="servWhatsApp" />
                <label for="servWhatsApp" class="modal-subtitle"
                  >Contact on WhatsApp</label
                >
              </div>
            </div>

            <div class="form-group">
              <label for="servCompany">Ministry / Company</label>
              <input
                type="text"
                id="servCompany"
                name="servCompany"
                placeholder="Your Organization Ltd."
              />
            </div>

            <div class="form-group" style="display: none;">
              <!-- Hidden field to map to 'Website' payload to prevent script breakage -->
              <input type="url" id="servWebsite" name="servWebsite" value="" />
            </div>

            <div class="form-group">
              <label>Primary Interest <span class="required">*</span></label>
              <div class="radio-wrapper">
                <div class="radio-item">
                  <input
                    type="radio"
                    id="intNetwork"
                    name="servRequired"
                    value="Networking"
                    required
                  />
                  <label for="intNetwork">Networking</label>
                </div>
                <div class="radio-item">
                  <input
                    type="radio"
                    id="intLeadership"
                    name="servRequired"
                    value="Leadership Training"
                    required
                  />
                  <label for="intLeadership">Leadership Training</label>
                </div>
                <div class="radio-item">
                  <input
                    type="radio"
                    id="intEvents"
                    name="servRequired"
                    value="Exclusive Events"
                    required
                  />
                  <label for="intEvents">Exclusive Events</label>
                </div>
              </div>
            </div>

            <div class="form-group confirm-group">
              <input
                type="checkbox"
                id="servConfirm"
                name="servConfirm"
                required
              />
              <label for="servConfirm" class="modal-subtitle"
                >I confirm that the details provided are accurate and I agree to
                be contacted. <span class="required">*</span></label
              >
            </div>

            <button type="submit" class="btn btn-primary w-100">
              <span class="btn-text">Submit Application</span>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Success / Error Popup -->
    <div id="successPopup" class="modal-overlay">
      <div class="modal-glass popup-glass">
        <span class="modal-close" id="closeSuccessPopupIcon">&times;</span>

        <div id="popupIconContainer" class="popup-icon">
          <!-- JS Injected Icon -->
        </div>

        <h3 id="popupTitle" class="modal-title popup-title">Success!</h3>
        <p id="popupText" class="modal-subtitle popup-text">
          Your request was processed.
        </p>

        <button
          type="button"
          id="closeSuccessBtn"
          class="btn btn-primary w-100"
        >
          <span class="btn-text">Awesome</span>
        </button>
      </div>
    </div>
  </main>

  <style>
    /* Custom Font Declarations */
    @font-face {
      font-family: "Trajan Pro 3";
      src: url("/fonts/Trajan Pro 3 Semibold.otf") format("opentype");
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: "Trajan Pro 3";
      src: url("/fonts/Trajan Pro 3 Regular.otf") format("opentype");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    .hero {
      width: 100%;
      min-height: min(760px, 100vh);
      padding: 1.5rem clamp(1.25rem, 5vw, 5.5rem) 1.75rem;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(243, 210, 122, 0.16);
      background: #050505;
    }

    .hero-agent { isolation: isolate; }
    .hero-video { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: #050505; }
    .hero-video video { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0.72; }
    .video-wash { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.82), rgba(0,0,0,.3) 58%, rgba(0,0,0,.35)), linear-gradient(180deg, rgba(0,0,0,.2), transparent 38%, rgba(0,0,0,.75)); }
    .hero-grid-lines { position: absolute; inset: 0; opacity: .16; background-image: linear-gradient(rgba(255,255,255,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px); background-size: 8.33% 12.5%; }
    .agent-hero-content { position: relative; z-index: 1; width: 100%; max-width: 1400px; margin: auto; padding: clamp(5rem, 14vh, 10rem) 0 5rem; }
    .agent-hero-copy { max-width: 900px; }
    .agent-eyebrow { display: flex; align-items: center; gap: .75rem; margin: 0 0 2.2rem; color: rgba(255,255,255,.62); font: .72rem/1.2 monospace; letter-spacing: .04em; }
    .agent-eyebrow span { width: 2rem; height: 1px; background: rgba(255,255,255,.45); }
    .agent-hero-copy h1 { margin: 0; color: #fff; font-family: "Trajan Pro 3", serif; font-size: clamp(2.8rem, 7vw, 7.3rem); font-weight: 600; line-height: .92; letter-spacing: -.055em; }
    .blur-word { display: inline-block; min-width: 4.4ch; color: #fff; transition: filter .5s ease, opacity .5s ease; }
    .agent-stats { position: relative; z-index: 1; display: flex; gap: clamp(2rem, 6vw, 6rem); max-width: 1400px; width: 100%; margin: 0 auto; }
    .agent-stats div { display: flex; flex-direction: column; gap: .35rem; }
    .agent-stats strong { color: #fff; font: 600 clamp(1.6rem, 3vw, 2.7rem)/1 "Trajan Pro 3", serif; }
    .agent-stats span { color: rgba(255,255,255,.5); font-size: .7rem; letter-spacing: .02em; }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0.18;
      background-image: linear-gradient(rgba(243, 210, 122, 0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(243, 210, 122, 0.12) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(to bottom, black, transparent 80%);
      pointer-events: none;
    }

    .hero-nav, .hero-grid, .hero-footer { position: relative; z-index: 1; }
    .hero-nav { display: flex; align-items: center; justify-content: space-between; padding-bottom: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.12); }
    .hero-brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--text-primary); text-decoration: none; text-transform: uppercase; font: 600 0.72rem/1.25 "Trajan Pro 3", serif; letter-spacing: 0.14em; }
    .hero-brand img { width: 34px; height: 34px; object-fit: contain; }
    .hero-links { display: flex; align-items: center; gap: clamp(1rem, 3vw, 3rem); }
    .hero-links a, .hero-footer { color: var(--text-secondary); text-decoration: none; text-transform: uppercase; font-size: 0.62rem; letter-spacing: 0.18em; }
    .hero-links a:hover, .text-link:hover { color: var(--accent-gold-end); }
    .nav-cta { padding: 0.8rem 1rem; border: 1px solid rgba(243,210,122,0.35); color: var(--accent-gold-end) !important; }
    .hero-grid { flex: 1; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr); align-items: center; gap: 3rem; padding: clamp(4rem, 11vh, 8rem) 0 3rem; }
    .hero-copy { max-width: 630px; }
    .eyebrow { color: var(--accent-gold-end); text-transform: uppercase; font-size: 0.68rem; letter-spacing: 0.22em; margin: 0 0 1.5rem; }
    .hero h1 { max-width: 700px; margin: 0; color: var(--text-primary); font: 600 clamp(3.8rem, 9vw, 8.5rem)/0.88 "Trajan Pro 3", serif; letter-spacing: -0.06em; }
    .hero h1 em { color: var(--accent-gold-end); font-style: normal; }
    .hero-description { max-width: 390px; color: var(--text-secondary); font-size: 1rem; line-height: 1.7; margin: 2rem 0; }
    .hero-actions { display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap; }
    .text-link { color: var(--text-primary); text-decoration: none; font-size: 0.75rem; letter-spacing: 0.08em; transition: color 0.3s ease; }
    .text-link span { color: var(--accent-gold-end); font-size: 1rem; margin-left: 0.35rem; }
    .hero-art { min-height: 420px; position: relative; display: grid; place-items: center; }
    .orbit { position: absolute; border: 1px solid rgba(243,210,122,0.25); border-radius: 50%; transform: rotate(-26deg); }
    .orbit-one { width: min(38vw, 520px); height: min(28vw, 380px); }
    .orbit-two { width: min(32vw, 430px); height: min(48vw, 610px); transform: rotate(38deg); border-color: rgba(144,18,30,0.55); }
    .orbit-three { width: min(25vw, 330px); height: min(25vw, 330px); border-style: dashed; animation: spin 24s linear infinite; }
    .hero-seal { width: clamp(120px, 15vw, 210px); aspect-ratio: 1; display: grid; place-items: center; border: 1px solid rgba(243,210,122,0.55); border-radius: 50%; background: radial-gradient(circle, rgba(144,18,30,0.45), rgba(13,13,13,0.65)); box-shadow: 0 0 80px rgba(144,18,30,0.25); }
    .hero-seal img { width: 46%; filter: sepia(1) saturate(0.7) brightness(1.4); }
    .art-label { position: absolute; color: rgba(255,255,255,0.55); font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.2em; }
    .art-label-top { top: 14%; right: 10%; } .art-label-bottom { bottom: 12%; left: 7%; }
    .hero-footer { display: flex; align-items: center; gap: 1rem; } .hero-line { height: 1px; flex: 1; background: rgba(255,255,255,0.18); }
    @keyframes spin { to { transform: rotate(334deg); } }

    main {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem;
      position: relative;
    }

    /* Abstract background shapes */
    .bg-shape-1,
    .bg-shape-2 {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      z-index: 0;
    }

    .bg-shape-1 {
      width: 400px;
      height: 400px;
      background: var(--brand-navy);
      top: -100px;
      left: -100px;
      opacity: 0.5;
    }

    .bg-shape-2 {
      width: 300px;
      height: 300px;
      background: var(--accent-burgundy);
      bottom: 0;
      right: 0;
      opacity: 0.3;
    }

    /* Glassmorphism Panel */
    .glass-panel {
      position: relative;
      z-index: 1;
      background: rgba(29, 53, 87, 0.15);
      border: 1px solid rgba(243, 210, 122, 0.2);
      border-radius: 16px;
      padding: 3rem 3rem 4rem;
      text-align: center;
      max-width: 800px;
      width: 100%;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }

    /* Square Logo Styling */
    .panel-logo {
      width: 90px;
      height: 90px;
      object-fit: contain;
      margin: 0 auto 1.5rem;
      display: block;
    }

    /* Typography Adjustments */
    .glass-panel h1,
    .modal-title {
      font-family: "Trajan Pro 3", serif;
      font-weight: 600;
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
      letter-spacing: 0.5px;
      color: var(--text-primary);
    }

    .subheading {
      font-family: "Trajan Pro 3", serif;
      font-weight: 400;
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
      color: var(--accent-gold-end);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .glass-panel p,
    .modal-subtitle {
      color: var(--text-secondary);
      font-size: 1.05rem;
      margin-bottom: 2.5rem;
      line-height: 1.6;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Action Buttons */
    .action-buttons {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      margin-bottom: 3rem;
    }

    .btn {
      padding: 0.85rem 1.75rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .w-100 {
      width: 100%;
    }

    .btn-primary {
      background: linear-gradient(
        90deg,
        var(--accent-gold-start),
        var(--accent-gold-end)
      );
      color: var(--bg-primary);
      border: none;
    }

    .btn-primary:hover {
      opacity: 0.9;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(200, 155, 60, 0.3);
    }

    .btn-whatsapp {
      background-color: #25d366;
      color: #ffffff;
      border: 1px solid #25d366;
    }

    .btn-whatsapp:hover {
      background-color: #1ebe5d;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
    }

    /* Countdown Grid */
    #countdown {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
    }

    .time-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 70px;
    }

    .time-value {
      font-size: 3rem;
      font-weight: 700;
      color: var(--text-primary);
      background: linear-gradient(
        90deg,
        var(--accent-gold-start),
        var(--accent-gold-end)
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
    }

    .time-label {
      font-size: 0.85rem;
      text-transform: uppercase;
      color: var(--text-secondary);
      letter-spacing: 2px;
      margin-top: 0.75rem;
    }

    /* Modal Styles - Liquid Glass */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      z-index: 9999;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
        visibility 0.4s;
    }

    .modal-overlay.show {
      opacity: 1;
      visibility: visible;
    }

    .modal-glass {
      position: relative;
      /* Blended background mimicking the website's bg-primary, navy, and burgundy shapes */
      background:
        radial-gradient(
          circle at top left,
          rgba(29, 53, 87, 0.8) 0%,
          transparent 60%
        ),
        radial-gradient(
          circle at bottom right,
          rgba(144, 18, 30, 0.5) 0%,
          transparent 60%
        ),
        rgba(13, 13, 13, 0.92);
      border: 1px solid rgba(243, 210, 122, 0.15);
      border-top: 1px solid rgba(255, 255, 255, 0.25);
      border-left: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 2.5rem;
      width: 90%;
      max-width: 500px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      box-shadow:
        0 16px 40px rgba(0, 0, 0, 0.4),
        inset 0 0 20px rgba(243, 210, 122, 0.05),
        inset 0 2px 3px rgba(255, 255, 255, 0.1);
      transform: translateY(20px) scale(0.95);
      transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .modal-overlay.show .modal-glass {
      transform: translateY(0) scale(1);
    }

    .popup-glass {
      max-width: 450px;
      text-align: center;
      padding: 40px 30px;
      height: auto;
    }

    .modal-scroll-wrapper {
      overflow-y: auto;
      overflow-x: hidden;
      scroll-behavior: smooth;
      padding-right: 15px;
      margin-right: -5px;
      flex-grow: 1;
    }

    .modal-scroll-wrapper::-webkit-scrollbar {
      width: 4px;
    }
    .modal-scroll-wrapper::-webkit-scrollbar-track {
      background: transparent;
    }
    .modal-scroll-wrapper::-webkit-scrollbar-thumb {
      background: rgba(243, 210, 122, 0.3);
      border-radius: 10px;
    }

    .modal-close {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 1.5rem;
      color: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      z-index: 2;
      transition:
        color 0.3s,
        transform 0.3s;
    }

    .modal-close:hover {
      color: var(--accent-gold-end);
      transform: rotate(90deg);
    }

    .modal-title {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      text-align: center;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }

    .modal-subtitle {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      text-align: center;
      color: rgba(255, 255, 255, 0.8);
    }

    /* Form Styles - Engraved Liquid Glass Inputs */
    .modal-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      text-align: left;
    }

    .form-group label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 500;
    }

    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="tel"],
    .form-group input[type="url"] {
      width: 100%;
      padding: 12px 15px;
      background: rgba(0, 0, 0, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      color: var(--text-primary);
      outline: none;
      box-shadow:
        inset 0 2px 5px rgba(0, 0, 0, 0.2),
        0 1px 0 rgba(255, 255, 255, 0.08);
      transition: all 0.3s ease;
    }

    .form-group input::placeholder {
      color: rgba(255, 255, 255, 0.3);
    }

    .form-group input:focus {
      background: rgba(0, 0, 0, 0.25);
      border-color: rgba(243, 210, 122, 0.4);
      box-shadow:
        inset 0 2px 5px rgba(0, 0, 0, 0.3),
        0 0 10px rgba(243, 210, 122, 0.1);
    }

    .required {
      color: #e45b5b;
    }

    .whatsapp-container {
      display: none;
      margin-top: 8px;
      align-items: center;
      gap: 8px;
    }

    .whatsapp-container input[type="checkbox"] {
      width: auto;
      margin: 0;
      cursor: pointer;
      accent-color: var(--accent-gold-end);
    }

    .whatsapp-container label {
      margin: 0;
      cursor: pointer;
    }

    .radio-wrapper {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 5px;
    }

    .radio-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .radio-item input[type="radio"] {
      cursor: pointer;
      accent-color: var(--accent-gold-end);
    }

    .confirm-group {
      flex-direction: row;
      align-items: flex-start;
      gap: 10px;
      margin-top: 10px;
      margin-bottom: 10px;
    }

    .confirm-group input {
      margin-top: 4px;
      cursor: pointer;
      accent-color: var(--accent-gold-end);
    }

    .confirm-group label {
      text-align: left;
      margin-bottom: 0;
      line-height: 1.4;
      cursor: pointer;
    }

    /* Popup Specifics */
    .popup-icon {
      font-size: 50px;
      margin-bottom: 20px;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    }
    .popup-title {
      margin-bottom: 15px;
    }
    .popup-text {
      margin-bottom: 30px;
    }

    .glass-panel p.fine-text {
      font-size: 0.8rem; /* Shrinks the text to a 'fine print' size */
      opacity: 0.7; /* Slightly dims the text so it doesn't distract from the main call-to-action */
      margin-top: -1rem; /* Pulls it slightly closer to the countdown timer */
      margin-bottom: 0;
    }

    /* Mobile Optimization */
    @media (max-width: 768px) {
      main {
        padding: 0;
      }

      .hero { min-height: 720px; padding: 1.25rem 1.25rem 1.5rem; }
      .hero-links a:not(.nav-cta) { display: none; }
      .agent-hero-content { padding: 5rem 0 7rem; }
      .agent-hero-copy h1 { font-size: clamp(3.4rem, 16vw, 6rem); }
      .agent-eyebrow { font-size: .62rem; }
      .agent-stats { gap: 1.25rem; flex-wrap: wrap; }
      .agent-stats strong { font-size: 1.55rem; }
      .agent-stats span { font-size: .58rem; }

      .glass-panel {
        padding: 2.5rem 1.5rem;
      }

      .panel-logo {
        width: 75px;
        height: 75px;
      }

      .glass-panel h1 {
        font-size: 1.5rem;
      }

      .subheading {
        font-size: 1rem;
      }

      .glass-panel p {
        font-size: 0.95rem;
        margin-bottom: 2rem;
      }

      .action-buttons {
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2.5rem;
      }

      .btn {
        width: 100%;
      }

      #countdown {
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .time-value {
        font-size: 2.25rem;
      }

      .bg-shape-1 {
        width: 250px;
        height: 250px;
      }

      .bg-shape-2 {
        width: 200px;
        height: 200px;
      }

      .modal-glass {
        padding: 2rem 1.5rem;
      }
    }
  </style>

  <script>
    // -- Hero word animation --
    const rotatingWords = ["lead", "influence", "connect", "scale"];
    const rotatingWord = document.querySelector(".blur-word");
    let rotatingIndex = 0;
    if (rotatingWord) {
      setInterval(() => {
        rotatingWord.style.filter = "blur(18px)";
        rotatingWord.style.opacity = "0";
        setTimeout(() => {
          rotatingIndex = (rotatingIndex + 1) % rotatingWords.length;
          rotatingWord.textContent = rotatingWords[rotatingIndex];
          rotatingWord.style.filter = "blur(0)";
          rotatingWord.style.opacity = "1";
        }, 350);
      }, 2500);
    }

    // -- 1. Countdown Logic --
    const launchDate = new Date("October 3, 2026 00:00:00").getTime();

    const updateCountdown = () => {
      const countdownEl = document.getElementById("countdown");
      if (!countdownEl) return;

      const now = new Date().getTime();
      const distance = launchDate - now;

      if (distance < 0) {
        countdownEl.innerHTML = "<h2>We have launched!</h2>";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor(
        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
      );
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      const updateEl = (id: string, value: number) => {
        const el = document.getElementById(id);
        if (el) el.innerText = value.toString().padStart(2, "0");
      };

      updateEl("days", days);
      updateEl("hours", hours);
      updateEl("minutes", minutes);
      updateEl("seconds", seconds);
    };

    setInterval(updateCountdown, 1000);
    updateCountdown();

    // -- 2. Modal & Form Submission Logic --
    document.addEventListener("DOMContentLoaded", () => {
      const signupModal = document.getElementById(
        "signupModal",
      ) as HTMLElement | null;
      const openSignupBtn = document.getElementById("openSignupModal");
      const navOpenSignupBtn = document.getElementById("navOpenSignupModal");
      const closeSignupBtn = document.getElementById("closeSignupModal");

      const successPopup = document.getElementById(
        "successPopup",
      ) as HTMLElement | null;
      const closeSuccessBtn = document.getElementById("closeSuccessBtn");
      const closeSuccessPopupIcon = document.getElementById(
        "closeSuccessPopupIcon",
      );

      // Pulls from Vercel environment variables securely, falling back to the hardcoded URL if not yet set
      const GOOGLE_API_URL =
        import.meta.env.PUBLIC_GOOGLE_API_URL ||
        "https://script.google.com/macros/s/AKfycbys6hUSU-zPewgXmP5YNcQGizJJL1zu-sR8XjA7YZeP31P4y3Da8Ol6GzTZO7kzqtq5rg/exec";

      // Unified function to open the modal
      const openModal = (e?: Event) => {
        if (e) e.preventDefault();
        signupModal?.classList.add("show");
      };

      // Open Signup Modal Event Listeners
      if (openSignupBtn) openSignupBtn.addEventListener("click", openModal);
      if (navOpenSignupBtn)
        navOpenSignupBtn.addEventListener("click", openModal);

      // Close Signup Modal
      if (closeSignupBtn && signupModal) {
        closeSignupBtn.addEventListener("click", () =>
          signupModal.classList.remove("show"),
        );
      }

      // Automatically open if navigating from the Contact page via the layout link
      if (window.location.hash === "#early-access") {
        openModal();
        // Clean up the URL hash to prevent reopening on page refresh
        window.history.replaceState(null, "", window.location.pathname);
      }

      // Close Modals on Outside Click
      window.addEventListener("click", (event) => {
        if (event.target === signupModal) signupModal?.classList.remove("show");
        if (event.target === successPopup)
          successPopup?.classList.remove("show");
      });

      // WhatsApp Dynamic Toggle Logic
      const phoneInput = document.getElementById(
        "servPhone",
      ) as HTMLInputElement | null;
      const whatsappContainer = document.getElementById(
        "whatsappCheckboxContainer",
      ) as HTMLElement | null;
      const whatsappCheckbox = document.getElementById(
        "servWhatsApp",
      ) as HTMLInputElement | null;

      if (phoneInput && whatsappContainer) {
        phoneInput.addEventListener("input", function () {
          if (phoneInput.value.trim().length > 0) {
            whatsappContainer.style.display = "flex";
          } else {
            whatsappContainer.style.display = "none";
            if (whatsappCheckbox) whatsappCheckbox.checked = false;
          }
        });
      }

      // Form Submission & Success Popup Logic
      const signupForm = document.getElementById(
        "signupForm",
      ) as HTMLFormElement | null;

      const popupIconContainer = document.getElementById(
        "popupIconContainer",
      ) as HTMLElement | null;
      const popupTitle = document.getElementById(
        "popupTitle",
      ) as HTMLElement | null;
      const popupText = document.getElementById(
        "popupText",
      ) as HTMLElement | null;

      if (signupForm) {
        signupForm.addEventListener("submit", async function (e) {
          e.preventDefault();

          const name =
            (document.getElementById("servFullName") as HTMLInputElement | null)
              ?.value ?? "";
          const email =
            (document.getElementById("servEmail") as HTMLInputElement | null)
              ?.value ?? "";
          const phone =
            (document.getElementById("servPhone") as HTMLInputElement | null)
              ?.value ?? "";
          const company =
            (document.getElementById("servCompany") as HTMLInputElement | null)
              ?.value ?? "";
          const website =
            (document.getElementById("servWebsite") as HTMLInputElement | null)
              ?.value ?? "";
          const whatsapp = (
            document.getElementById("servWhatsApp") as HTMLInputElement | null
          )?.checked
            ? "Yes"
            : "No";
          const projectType =
            (
              document.querySelector(
                'input[name="servRequired"]:checked',
              ) as HTMLInputElement | null
            )?.value ?? "";

          const now = new Date();
          const projectDate = now.toLocaleDateString("en-GB");
          const time = now.toLocaleTimeString("en-US", { hour12: false });

          const payload = {
            action: "signup",
            Name: name,
            Contact: email,
            Phone: phone,
            Company: company,
            Website: website,
            WhatsApp: whatsapp,
            ProjectType: projectType,
            ProjectDate: projectDate,
            Time: time,
            Completion: "New",
          };

          const submitBtnText = signupForm.querySelector(
            ".btn-text",
          ) as HTMLElement | null;
          const originalText = submitBtnText?.innerText ?? "Submit";
          if (submitBtnText) submitBtnText.innerText = "Submitting...";

          try {
            const response = await fetch(GOOGLE_API_URL, {
              method: "POST",
              body: JSON.stringify(payload),
              headers: { "Content-Type": "text/plain;charset=utf-8" },
            });

            const data = await response.json();

            signupModal?.classList.remove("show");

            if (data.success) {
              if (popupIconContainer) {
                popupIconContainer.innerHTML = "✅";
                popupIconContainer.style.color = "var(--accent-gold-start)";
              }
              if (popupTitle) popupTitle.innerText = "Position Secured!";
              if (popupText)
                popupText.innerText =
                  "Thank you! Your details have been successfully logged. We will review them and touch base with you shortly.";

              signupForm.reset();
              if (whatsappContainer) whatsappContainer.style.display = "none";
            } else {
              if (popupIconContainer) {
                popupIconContainer.innerHTML = "❌";
                popupIconContainer.style.color = "#e45b5b";
              }
              if (popupTitle) popupTitle.innerText = "That Did Not Work";
              if (popupText)
                popupText.innerText =
                  "Unfortunately, we stumbled upon an issue processing your request. Please try again or join our WhatsApp group directly.";
            }

            successPopup?.classList.add("show");
          } catch (error) {
            console.error("Network Error:", error);
            signupModal?.classList.remove("show");

            if (popupIconContainer) {
              popupIconContainer.innerHTML = "⚠️";
              popupIconContainer.style.color = "#e45b5b";
            }
            if (popupTitle) popupTitle.innerText = "Connection Issue";
            if (popupText)
              popupText.innerText =
                "We can't reach the server right now. Please check your internet connection, or try again later.";

            successPopup?.classList.add("show");
          } finally {
            if (submitBtnText) submitBtnText.innerText = originalText;
          }
        });
      }

      const hideSuccessPopup = () => successPopup?.classList.remove("show");
      if (closeSuccessBtn)
        closeSuccessBtn.addEventListener("click", hideSuccessPopup);
      if (closeSuccessPopupIcon)
        closeSuccessPopupIcon.addEventListener("click", hideSuccessPopup);
    });
  </script>
</Layout>
