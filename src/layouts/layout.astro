---
// src/layouts/layout.astro
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Added FontAwesome CDN to render the menu icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <body>
    <nav>
      <div class="nav-bg"></div>

      <div class="nav-content">
        <a
          href="/"
          class="brand-logo"
          aria-label="The Distinguished Daniel - Home"
        >
          <img
            src="/logos/logoline.webp"
            alt="The Distinguished Daniel Logo"
            loading="eager"
          />
        </a>

        <!-- Desktop Navigation Links -->
        <div class="nav-links desktop-only">
          <a href="/">Home</a>
          <a href="/#early-access" id="navOpenSignupModal">Early Access</a>
          <a href="/contact">Contact</a>
        </div>

        <!-- Mobile Menu Open Button -->
        <button class="mobile-menu-btn open-btn" aria-label="Open Menu">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </nav>

    <!-- Dark Overlay for when the panel is open -->
    <div id="panelOverlay" class="panel-overlay"></div>

    <!-- Mobile Side Panel -->
    <div id="sidePanel" class="side-panel">
      <button class="mobile-menu-btn close-btn" aria-label="Close Menu">
        <i class="fa-solid fa-bars-staggered"></i>
      </button>
      <div class="side-panel-links">
        <a href="/">Home</a>
        <a href="/#early-access" class="mobileOpenSignupModal">Early Access</a>
        <a href="/contact">Contact</a>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <div class="footer-section brand-section">
          <img
            src="/logos/logoline.webp"
            alt="The Distinguished Daniel Logo"
            class="footer-logo"
            loading="lazy"
          />
          <p>Elevating standards and building networks of excellence.</p>
        </div>

        <div class="footer-section">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="#about">About Us</a></li>
            <li><a href="#programs">Programs</a></li>
            <li><a href="#events">Events</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4>Legal</h4>
          <ul>
            <li><a href="#privacy">Privacy Policy</a></li>
            <li><a href="#terms">Terms of Service</a></li>
          </ul>
        </div>

        <div class="footer-section">
          <h4>Connect</h4>
          <ul>
            <li><a href="#linkedin">LinkedIn</a></li>
            <li><a href="#instagram">Instagram</a></li>
            <li><a href="#facebook">Facebook</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        &copy; {new Date().getFullYear()} The Distinguished Daniel Network and Institute.
        All rights reserved.
      </div>
    </footer>

    <!-- Added JavaScript to handle opening and closing the mobile panel -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const openBtn = document.querySelector(".open-btn");
        const closeBtn = document.querySelector(".close-btn");
        const sidePanel = document.getElementById("sidePanel");
        const panelOverlay = document.getElementById("panelOverlay");
        const sidePanelLinks = document.querySelectorAll(".side-panel-links a");

        function openMenu() {
          if (sidePanel && panelOverlay) {
            sidePanel.classList.add("open");
            panelOverlay.classList.add("show");
          }
        }

        function closeMenu() {
          if (sidePanel && panelOverlay) {
            sidePanel.classList.remove("open");
            panelOverlay.classList.remove("show");
          }
        }

        if (openBtn) openBtn.addEventListener("click", openMenu);
        if (closeBtn) closeBtn.addEventListener("click", closeMenu);
        if (panelOverlay) panelOverlay.addEventListener("click", closeMenu);

        // Closes the menu automatically when a link is clicked
        sidePanelLinks.forEach((link) => {
          link.addEventListener("click", closeMenu);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #0d0d0d;
    --brand-navy: #1d3557;
    --accent-gold-start: #c89b3c;
    --accent-gold-end: #f3d27a;
    --accent-burgundy: #90121e;
    --text-primary: #f8f9fa;
    --text-secondary: #c7c7c7;
    --border-charcoal: #2a2a2a;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: "Inter", "Source Sans Pro", system-ui, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex-grow: 1;
    padding-top: 100px; /* Increased to accommodate larger header */
  }

  nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
  }

  .nav-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 150%;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(13, 13, 13, 0.95) 30%,
      rgba(13, 13, 13, 0.6) 70%,
      transparent 100%
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
    pointer-events: none;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 3rem; /* Slightly larger padding */
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .brand-logo img {
    height: 42px; /* Increased logo size */
    width: auto;
    display: block;
    transition: opacity 0.2s ease;
  }

  .brand-logo:hover img {
    opacity: 0.85;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  footer {
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-charcoal);
    color: var(--text-secondary);
    padding: 4rem 3rem 2rem;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto 3rem;
  }

  .footer-logo {
    height: 42px;
    width: auto;
    margin-bottom: 1rem;
    display: block;
  }

  .brand-section p {
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 300px;
  }

  .footer-section h4 {
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .footer-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-section a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .footer-section a:hover {
    color: var(--accent-gold-start);
  }

  .footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-charcoal);
    font-size: 0.85rem;
  }

  /* --- New Side Panel Styles --- */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 201;
    transition: color 0.3s ease;
  }

  .mobile-menu-btn:hover {
    color: var(--accent-gold-start);
  }

  .side-panel {
    position: fixed;
    top: 0;
    right: -100%; /* Hidden off-screen by default */
    width: 300px;
    max-width: 80vw;
    height: 100vh;
    background: var(--bg-primary);
    border-left: 1px solid var(--border-charcoal);
    padding: 5rem 2rem 2rem;
    transition: right 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    z-index: 200;
    display: flex;
    flex-direction: column;
    box-shadow: -5px 0 30px rgba(0, 0, 0, 0.5);
  }

  .side-panel.open {
    right: 0; /* Slides in */
  }

  .side-panel .close-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: block; /* Always visible inside the panel */
  }

  .side-panel-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .side-panel-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .side-panel-links a:hover {
    color: var(--text-primary);
  }

  .panel-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 199;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease;
  }

  .panel-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 768px) {
    .nav-content {
      padding: 1.25rem 1.5rem;
    }

    .brand-logo img {
      height: 32px;
    }

    /* Hide standard links, show hamburger button */
    .desktop-only {
      display: none !important;
    }

    .mobile-menu-btn.open-btn {
      display: block;
    }

    main {
      padding-top: 85px;
    }

    footer {
      padding: 3rem 1.5rem 1.5rem;
    }

    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .footer-logo {
      margin: 0 auto 1rem auto;
    }

    .brand-section p {
      margin: 0 auto;
    }
  }
</style>
